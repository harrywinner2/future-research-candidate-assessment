# Copy to .env and adjust. Settings are namespaced with COACH_KG_.

# Graph backend: "neo4j" (production) or "memory" (in-process, no DB needed)
COACH_KG_GRAPH_BACKEND=memory
COACH_KG_NEO4J_URI=bolt://localhost:7687
COACH_KG_NEO4J_USER=neo4j
COACH_KG_NEO4J_PASSWORD=coach-kg-dev

# LLM provider: "openai" (OPENAI_API_KEY), "anthropic" (ANTHROPIC_API_KEY),
# or "fake" (deterministic scripted responses, no key needed). The Settings
# screen can switch provider/model/key at runtime without a restart.
COACH_KG_LLM_PROVIDER=openai
COACH_KG_LLM_MODEL=gpt-4o-mini
COACH_KG_LLM_TEMPERATURE=0.2
COACH_KG_LLM_MAX_TOKENS=2048
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: "hash" (deterministic, no model download) or "sentence-transformers"
COACH_KG_EMBEDDINGS_PROVIDER=hash
COACH_KG_EMBEDDINGS_MODEL=all-MiniLM-L6-v2
COACH_KG_EMBEDDINGS_DIMENSION=384

# Retrieval
COACH_KG_RETRIEVAL_TOP_K=8
COACH_KG_RETRIEVAL_GRAPH_DEPTH=2
COACH_KG_RETRIEVAL_MAX_CONTEXT_TOKENS=4000

# Safety
COACH_KG_SAFETY_LEVEL=standard

# Validator
COACH_KG_VALIDATOR_STRICT=true
COACH_KG_VALIDATOR_MAX_RETRIES=2

# Boot behavior
COACH_KG_SEED_ON_BOOT=true
COACH_KG_EXERCISES_PATH=exercises.json

# Observability
COACH_KG_LOG_LEVEL=INFO
COACH_KG_TRACE_RETENTION=500
